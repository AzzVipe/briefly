# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/briefly"

# Ollama
OLLAMA_BASE_URL="http://172.17.0.1:11434"

# Models
CHAT_MODEL="llama3"
EMBED_MODEL="nomic-embed-text"

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.7